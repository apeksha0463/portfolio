# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Optional AI mode for the "Ask About Apeksha" chatbot ---------------------
# Without these, the chatbot still works using the built-in local answers.

# Turns on AI answers in the browser (true/false). This is not a secret.
VITE_AI_CHAT=false

# Server-only secret. Used by api/chat.js — never prefix it with VITE_.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-opus-5).
# CHAT_MODEL=claude-opus-5
